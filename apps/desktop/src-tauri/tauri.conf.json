{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "ClawGear",
  "version": "0.1.0",
  "identifier": "com.clawgear.desktop",
  "build": {
    "frontendDist": "../../dashboard/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../dashboard && pnpm dev",
    "beforeBuildCommand": "cd ../dashboard && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ClawGear",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "notification": {
      "enabled": true
    }
  }
}
