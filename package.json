{
  "name": "clawgear",
  "private": true,
  "version": "0.1.0",
  "description": "CEO Agent Operating System - orchestrate teams of AI agents to run a business",
  "scripts": {
    "dev": "bun run --filter @clawgear/api dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @clawgear/db generate",
    "db:migrate": "pnpm --filter @clawgear/db migrate",
    "db:seed": "pnpm --filter @clawgear/db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.32.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6"
  }
}
