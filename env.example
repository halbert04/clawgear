# ClawGear Environment Configuration
# Copy to .env and fill in values: cp env.example .env

# Instance
CLAWGEAR_INSTANCE_ID=dev-local
CLAWGEAR_PORT=3000
CLAWGEAR_HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://clawgear:clawgear@localhost:5432/clawgear

# Security
CLAWGEAR_MASTER_KEY=change-me-in-production-use-64-hex-chars
CLAWGEAR_JWT_SECRET=change-me-in-production

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-...

# Anthropic (for LLM-as-Judge and Claude Code adapter)
ANTHROPIC_API_KEY=sk-ant-...

# Docker Sandbox
CLAWGEAR_SANDBOX_NETWORK=clawgear-sandbox
CLAWGEAR_SANDBOX_MEMORY_LIMIT=2g
CLAWGEAR_SANDBOX_CPU_LIMIT=1.0

# Logging
LOG_LEVEL=info
